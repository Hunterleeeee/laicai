{
  "name": "code-review",
  "description": "对代码文件或目录进行质量审查，检查潜在的安全漏洞、性能瓶颈、代码异味和最佳实践偏离。输出结构化的审查报告。",
  "tools": [
    "file.read",
    "code.search",
    "shell.exec"
  ],
  "steps": [
    {
      "kind": "prompt",
      "name": "prompt",
      "max_tokens": 1400
    }
  ],
  "vault_context": {
    "enabled": false
  },
  "web_fetch": {
    "enabled": false
  },
  "output": {
    "save_by_default": false,
    "folder": "03 Reviews",
    "title_template": "Code Review - {{goal}}"
  }
}
