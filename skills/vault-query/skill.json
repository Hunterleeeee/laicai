{
  "name": "vault-query",
  "description": "查询 Obsidian Vault 中的相关笔记，提取匹配内容并整理为可引用的上下文。",
  "tools": [
    "vault.search",
    "code.search",
    "file.read",
    "wiki.build"
  ],
  "steps": [
    {
      "kind": "vault_context",
      "name": "vault-context",
      "query_from": "query",
      "limit": 8
    },
    {
      "kind": "prompt",
      "name": "prompt",
      "max_tokens": 900
    }
  ],
  "vault_context": {
    "enabled": true,
    "query_from": "query",
    "limit": 8
  },
  "web_fetch": {
    "enabled": false
  },
  "output": {
    "save_by_default": false,
    "folder": "03 Wiki",
    "title_template": "Vault Query - {{query}}"
  }
}
