{
  "name": "test-runner",
  "description": "自动检测项目测试/构建命令并运行验证，失败时提取关键错误用于修复。",
  "tools": [
    "verify.build",
    "shell.exec",
    "code.search",
    "file.read"
  ],
  "steps": [
    {
      "kind": "prompt",
      "name": "prompt",
      "max_tokens": 900
    }
  ],
  "vault_context": {
    "enabled": false
  },
  "web_fetch": {
    "enabled": false
  },
  "output": {
    "save_by_default": false,
    "folder": "03 Reviews",
    "title_template": "Test Runner - {{goal}}"
  }
}
