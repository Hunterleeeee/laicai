{
  "name": "deepseek-web-to-api",
  "description": "将 DeepSeek 网页端对话转换为可调用的本地 API 接口，支持提取聊天记录、模拟请求或搭建代理服务。",
  "tools": [
    "web.fetch",
    "file.write",
    "shell.exec"
  ],
  "steps": [
    {
      "kind": "web_fetch",
      "name": "web-fetch",
      "url_from": "url",
      "chars": 8000
    },
    {
      "kind": "prompt",
      "name": "prompt",
      "max_tokens": 1400
    },
    {
      "kind": "save_note",
      "name": "save-note",
      "folder": "deepseek-api",
      "save_by_default": true
    }
  ],
  "vault_context": {
    "enabled": false
  },
  "web_fetch": {
    "enabled": true,
    "url_from": "url"
  },
  "output": {
    "save_by_default": true,
    "folder": "deepseek-api",
    "title_template": "DeepSeek API - {{goal}}"
  }
}
