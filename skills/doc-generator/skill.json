{
  "name": "doc-generator",
  "description": "根据代码、配置或主题生成 README、API 文档、使用说明或 Obsidian 风格文档。",
  "tools": [
    "file.read",
    "code.search",
    "wiki.build",
    "file.write",
    "file.edit"
  ],
  "steps": [
    {
      "kind": "prompt",
      "name": "prompt",
      "max_tokens": 1200
    }
  ],
  "vault_context": {
    "enabled": false
  },
  "web_fetch": {
    "enabled": false
  },
  "output": {
    "save_by_default": false,
    "folder": "03 Wiki",
    "title_template": "文档草稿 - {{goal}}"
  }
}
