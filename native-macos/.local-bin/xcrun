#!/bin/bash
# Intercept xcrun calls that fail with CommandLineTools
# and provide the missing PlatformPath response
for arg in "$@"; do
    case "$arg" in
        --show-sdk-platform-path)
            echo "/Library/Developer/CommandLineTools"
            exit 0
            ;;
    esac
done
# Pass through everything else to real xcrun
exec /usr/bin/xcrun "$@"
